# FitCoach API — copy to backend/.env for local development, or set these in Render → Environment.

# MongoDB (e.g. MongoDB Atlas connection string) and database name
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=fitcoach

# Long random string used to sign login tokens (Render can generate one)
JWT_SECRET=change-me-to-a-long-random-string

# Your frontend URL(s), comma-separated, allowed to call the API
CORS_ORIGINS=https://fitcoach-web.onrender.com

# Admin account (created/updated on startup). Password: at least 10 characters.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=

# Business timezone used for session times and "today"
APP_TIMEZONE=Asia/Kolkata

# AI drafts, meal plans and food analysis (Google AI Studio → API key). Optional: without it,
# coaches start plans from a template and food analysis shows "try again later".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# "Continue with Google" (Google Cloud Console → OAuth client ID, type: Web). Optional.
GOOGLE_CLIENT_ID=

# Booking emails and reminders via Gmail (App Password). Optional.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_ENABLED=true
REMINDER_HOURS_BEFORE=24

# Razorpay checkout. Optional — membership page shows "Coming soon" without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay Dashboard → Webhooks). Needed for auto-renewal to extend memberships.
RAZORPAY_WEBHOOK_SECRET=

# Push notifications: keys are generated automatically and stored in MongoDB — nothing to set.
# Optional: contact for push services (defaults to mailto:ADMIN_EMAIL), or bring your own key (PEM).
VAPID_SUBJECT=
VAPID_PRIVATE_KEY=

# Video call relay (TURN) — strongly recommended: without it some mobile and office networks can't connect calls.
# Easiest: a managed relay with a free tier. Metered: create an app at metered.ca → TURN Server → copy the domain and API key.
METERED_DOMAIN=
METERED_API_KEY=
# …or Cloudflare Realtime TURN (Dashboard → Realtime → TURN Server → create key):
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# …or your own TURN server (e.g. coturn) with fixed credentials:
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Local development only: create demo trainers (password Trainer@123). Never enable in production.
SEED_DEMO_DATA=false

# Privacy: shown on the privacy policy and in the app as the contact for data requests and complaints
# (your grievance officer). Defaults to ADMIN_EMAIL.
PRIVACY_CONTACT_EMAIL=

# Who runs FitCoach — shown on /terms, /privacy, /refunds and /contact (consumer law expects these to be public).
# As an individual (sole proprietor) use your own full name; a correspondence address is fine (city + PIN at minimum).
BUSINESS_NAME=
BUSINESS_ADDRESS=
CONTACT_PHONE=
GRIEVANCE_OFFICER=
JURISDICTION_CITY=
# Only if you are GST-registered; leave empty otherwise (then no GST is charged or shown).
GSTIN=
# Certifications your coaches actually hold (shown on the sign-in page), e.g. "ACE CPT · ISSA Nutritionist · YCB Level 2".
COACH_CREDENTIALS=

# Your website's address, used in email links (password reset, bookings). Defaults to the first CORS_ORIGINS entry.
APP_URL=
